{
  "id": "soulmate",
  "name": "Soulmate",
  "category": "love",
  "description": "A multi-page galaxy-themed soulmate website with combined moon matching, love letter, star-catching game, timeline, and memory album.",
  "price": 599,
  "currency": "INR",
  "version": "1.0.0",
  "active": true,
  "templatePath": "/templates/love/soulmate/template.html",
  "previewImage": "/templates/love/soulmate/preview.jpg",
  "features": [
    "Multi-page navigation (no scroll)",
    "Personalized names and welcome message",
    "Combined moon phase matching (based on DOB)",
    "Love letter page",
    "Galaxy star-catching game",
    "Animated timeline",
    "Unique memory album layout",
    "Custom accent colors and gradients",
    "Background music (auto-plays after entry)",
    "Responsive design"
  ],
  "customization": {
    "theme": {
      "label": "Theme Name",
      "type": "text",
      "default": "soulmate",
      "required": true,
      "maxLength": 30,
      "placeholder": "e.g. soulmate, forever, starlight"
    },
    "partner1": {
      "label": "Your Name",
      "type": "text",
      "default": "you",
      "required": true,
      "maxLength": 40,
      "placeholder": "e.g. Arjun"
    },
    "partner2": {
      "label": "Partner's Name",
      "type": "text",
      "default": "me",
      "required": true,
      "maxLength": 40,
      "placeholder": "e.g. Anjali"
    },
    "heroTitle": {
      "label": "Welcome Title",
      "type": "text",
      "default": "soulmate ✦",
      "required": true,
      "maxLength": 60,
      "placeholder": "e.g. soulmate ✦"
    },
    "heroSubtitle": {
      "label": "Welcome Subtitle",
      "type": "text",
      "default": "two souls, one galaxy. where every star remembers your name.",
      "required": true,
      "maxLength": 150,
      "placeholder": "e.g. two souls, one galaxy..."
    },
    "letter": {
      "label": "Love Letter",
      "type": "textarea",
      "default": "Every star in the sky reminds me of you.\n\nIn this vast universe, I found my home in your eyes. Your love is the gravity that keeps me orbiting, the light that guides me through the darkest nights.\n\nWith every heartbeat, I choose you. With every breath, I love you more.",
      "required": true,
      "maxLength": 3000
    },
    "letterSalutation": {
      "label": "Letter Salutation",
      "type": "text",
      "default": "my dearest,",
      "required": false,
      "maxLength": 60,
      "placeholder": "e.g. my dearest,"
    },
    "letterSignature": {
      "label": "Letter Signature",
      "type": "text",
      "default": "forever yours",
      "required": false,
      "maxLength": 60,
      "placeholder": "e.g. forever yours"
    },
    "musicUrl": {
      "label": "Background Music",
      "type": "audio",
      "required": false,
      "maxSizeMB": 100,
      "accept": "audio/mpeg,audio/mp3,audio/wav,audio/ogg",
      "help": "Optional romantic soundtrack. Leave empty for the built-in ambient pad."
    },
    "colors": {
      "label": "Color Theme",
      "type": "colorGroup",
      "fields": {
        "accent": {
          "label": "Accent Color",
          "type": "color",
          "default": "#b7a6ff"
        },
        "gradient1": {
          "label": "Gradient Color 1",
          "type": "color",
          "default": "#ffe6c7"
        },
        "gradient2": {
          "label": "Gradient Color 2",
          "type": "color",
          "default": "#c7b9ff"
        },
        "gradient3": {
          "label": "Gradient Color 3",
          "type": "color",
          "default": "#a5d8ff"
        },
        "background": {
          "label": "Page Background",
          "type": "color",
          "default": "#050510"
        }
      }
    },
    "photos": {
      "label": "Our Memories",
      "type": "imageGallery",
      "required": false,
      "maxFiles": 20,
      "maxSizeMB": 150,
      "accept": "image/jpeg,image/png,image/webp,image/gif",
      "help": "Photos for the memory album. Up to 50 MB each."
    },
    "album": {
      "label": "Memory Album Items",
      "type": "textArray",
      "default": [
        "🌙 | the first moon we saw together",
        "⭐ | a star named after us",
        "☄️ | our midnight comet",
        "🌌 | galaxy in your eyes",
        "💫 | shooting star wish",
        "🌠 | forever orbit"
      ],
      "required": false,
      "maxItems": 20,
      "help": "Format: emoji | caption. One per line."
    },
    "timeline": {
      "label": "Timeline Events",
      "type": "textArray",
      "default": [
        "first spark | the universe whispered, and two constellations aligned.",
        "first 'i love you' | under a shared moon, words became gravity.",
        "infinite loop | still falling, still glowing, still you."
      ],
      "required": false,
      "maxItems": 10,
      "help": "Format: title | description. One per line."
    }
  },
  "sections": [
    { "title": "The names", "subtitle": "Who is this galaxy for?", "fields": ["partner1", "partner2"] },
    { "title": "Welcome message", "subtitle": "Set the mood for the journey.", "fields": ["theme", "heroTitle", "heroSubtitle"] },
    { "title": "Your love letter", "subtitle": "Put the feelings into words.", "fields": ["letterSalutation", "letter", "letterSignature"] },
    { "title": "Your memories", "subtitle": "Add photos, album items and timeline events.", "fields": ["photos", "album", "timeline"] },
    { "title": "Colors & Music", "subtitle": "Tune the vibe and soundtrack.", "fields": ["colors", "musicUrl"] }
  ],
  "preview": {
    "nameField": "partner2",
    "senderField": "partner1",
    "messageField": "letter",
    "photosField": "photos",
    "themeField": "theme"
  }
}