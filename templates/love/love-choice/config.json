{
  "id": "love-choice",
  "name": "Love Choice",
  "category": "love",
  "description": "One template, two websites. Choose 'Date Invitation' (playful ask + date/time + game) or 'Love Proposal' (letter + game + proposal certificate). Only the chosen experience is published.",
  "templatePath": "/templates/love/love-choice/template.html",
  "thumbnail": "/templates/love/love-choice/thumb.jpg",

  "templateLimits": {
    "photoSlots": 0
  },

  "sections": [
    {
      "title": "Choose your experience",
      "subtitle": "This template has TWO websites inside. Pick one — only the one you pick gets published.",
      "fields": ["mode"]
    },
    {
      "title": "The Couple",
      "subtitle": "Who's asking, and who's being asked?",
      "fields": ["fromName", "toName"]
    },
    {
      "title": "Page 1 — The Ask",
      "subtitle": "The opening question",
      "fields": ["askEyebrow", "askQuestion", "askSubtitle", "yesButton", "noButton"],
      "showIf": { "mode": "date" }
    },
    {
      "title": "The Letter",
      "subtitle": "Say why",
      "fields": ["letterTitle", "letterGreeting", "letterBody", "letterSignature", "letterSignatureName"]
    },
    {
      "title": "Date & Time",
      "subtitle": "When are we doing this?",
      "fields": ["whenTitle", "whenSubtitle", "whenHint"],
      "showIf": { "mode": "date" }
    },
    {
      "title": "The Game",
      "subtitle": "A convincing mini-game",
      "fields": ["gameTitle", "gameSubtitle", "gameStart", "gameWin", "gameLose", "gameTarget"]
    },
    {
      "title": "Final Confirmation",
      "subtitle": "The happy ending",
      "fields": ["finalEyebrow", "finalTitle", "finalBody", "finalVenue", "finalFooter", "finalButton"],
      "showIf": { "mode": "date" }
    },
    {
      "title": "Proposal Confirmation",
      "subtitle": "The 'Yes' certificate",
      "fields": ["proposalEyebrow", "proposalTitle", "proposalBody", "certificateTitle", "certificateNote", "proposalFooter", "proposalButton"],
      "showIf": { "mode": "proposal" }
    },
    {
      "title": "Song",
      "subtitle": "Background music",
      "fields": ["songEnabled", "songSrc"]
    }
  ],

  "customization": {
    "mode": {
      "type": "select",
      "label": "Which website do you want to publish?",
      "default": "date",
      "options": [
        { "value": "date", "label": "📅 Date Invitation — ask them out with date & time" },
        { "value": "proposal", "label": "💍 Love Proposal — a full proposal experience with certificate" }
      ],
      "help": "The other experience's fields will be hidden. Only the one you pick will be published."
    },

    "fromName": {
      "type": "text",
      "label": "Your name",
      "placeholder": "e.g. Aarav",
      "default": "Aarav",
      "required": true,
      "maxLength": 30
    },
    "toName": {
      "type": "text",
      "label": "Their name",
      "placeholder": "e.g. Diya",
      "default": "Diya",
      "required": true,
      "maxLength": 30
    },

    "askEyebrow": {
      "type": "text",
      "label": "Small label above question",
      "placeholder": "I have something to ask you…",
      "default": "I have something to ask you…",
      "maxLength": 60
    },
    "askQuestion": {
      "type": "text",
      "label": "The question",
      "placeholder": "Will you go out with me?",
      "default": "Will you go out with me?",
      "required": true,
      "maxLength": 80
    },
    "askSubtitle": {
      "type": "textarea",
      "label": "Subtitle",
      "placeholder": "There's a little plan…",
      "default": "There's a little plan I've been carrying around in my head for a while. And it involves you.",
      "maxLength": 250
    },
    "yesButton": {
      "type": "text",
      "label": "Yes button text",
      "placeholder": "Yes, obviously ♥",
      "default": "Yes, obviously ♥",
      "maxLength": 30
    },
    "noButton": {
      "type": "text",
      "label": "No button text",
      "placeholder": "No (for now)",
      "default": "No (for now)",
      "maxLength": 30
    },

    "letterTitle": {
      "type": "text",
      "label": "Letter title",
      "placeholder": "Read this first",
      "default": "Read this first",
      "maxLength": 60
    },
    "letterGreeting": {
      "type": "text",
      "label": "Greeting",
      "placeholder": "Dear Diya,",
      "default": "Dear Diya,",
      "maxLength": 60
    },
    "letterBody": {
      "type": "textarea",
      "label": "Letter body",
      "placeholder": "Write from the heart…",
      "default": "I've been trying to figure out how to say this without sounding like a fool. So I'm just going to say it: I really like you. Not in a small way — in the kind of way where I think about what you'd say to something before I even do it.\n\nI'd like to take you somewhere. Somewhere quiet. Somewhere where we can talk and laugh and not check the time. Just us, for a few hours.\n\nIf you say yes, I promise to make it a day you'll remember.",
      "required": true,
      "maxLength": 2000,
      "help": "Separate paragraphs with a blank line."
    },
    "letterSignature": {
      "type": "text",
      "label": "Sign-off",
      "placeholder": "Hoping you say yes,",
      "default": "Hoping you say yes,",
      "maxLength": 40
    },
    "letterSignatureName": {
      "type": "text",
      "label": "Signed by",
      "placeholder": "Your name",
      "default": "Aarav",
      "maxLength": 40
    },

    "whenTitle": {
      "type": "text",
      "label": "Date page title",
      "placeholder": "When works for you?",
      "default": "When works for you?",
      "maxLength": 60
    },
    "whenSubtitle": {
      "type": "textarea",
      "label": "Date page subtitle",
      "placeholder": "Pick a day and a time…",
      "default": "Pick a day and a time — I'll plan everything around it.",
      "maxLength": 200
    },
    "whenHint": {
      "type": "text",
      "label": "Date page hint",
      "placeholder": "No pressure, just us.",
      "default": "No pressure, just us.",
      "maxLength": 60
    },

    "gameTitle": {
      "type": "text",
      "label": "Game title",
      "placeholder": "One last thing",
      "default": "One last thing",
      "maxLength": 60
    },
    "gameSubtitle": {
      "type": "textarea",
      "label": "Game instructions",
      "placeholder": "Catch the hearts…",
      "default": "Catch 10 hearts in 30 seconds. Each one is a reason to say yes.",
      "maxLength": 200
    },
    "gameStart": {
      "type": "text",
      "label": "Start button",
      "placeholder": "Start catching",
      "default": "Start catching",
      "maxLength": 30
    },
    "gameWin": {
      "type": "text",
      "label": "Win message",
      "placeholder": "You did it!",
      "default": "You caught every one. And you've made me the happiest person alive. ♥",
      "maxLength": 150
    },
    "gameLose": {
      "type": "text",
      "label": "Lose message",
      "placeholder": "Almost!",
      "default": "Almost! Try again — the hearts are worth catching. 💕",
      "maxLength": 150
    },
    "gameTarget": {
      "type": "text",
      "label": "Hearts to catch",
      "placeholder": "10",
      "default": "10",
      "maxLength": 2
    },

    "finalEyebrow": {
      "type": "text",
      "label": "Final label (date mode)",
      "placeholder": "It's a date",
      "default": "It's a date",
      "maxLength": 40
    },
    "finalTitle": {
      "type": "text",
      "label": "Final heading (date mode)",
      "placeholder": "See you then ♥",
      "default": "See you then ♥",
      "maxLength": 60
    },
    "finalBody": {
      "type": "textarea",
      "label": "Final message (date mode)",
      "placeholder": "Bring yourself…",
      "default": "Bring yourself. Bring your laugh. Bring your stories. Everything else — I'll take care of.",
      "maxLength": 400
    },
    "finalVenue": {
      "type": "text",
      "label": "Where? (date mode)",
      "placeholder": "A little café with fairy lights",
      "default": "A little café with fairy lights",
      "maxLength": 100
    },
    "finalFooter": {
      "type": "text",
      "label": "Footer line (date mode)",
      "placeholder": "With all my heart ♥",
      "default": "With all my heart ♥",
      "maxLength": 80
    },
    "finalButton": {
      "type": "text",
      "label": "Replay button (date mode)",
      "placeholder": "Ask me again",
      "default": "Ask me again ↻",
      "maxLength": 40
    },

    "proposalEyebrow": {
      "type": "text",
      "label": "Proposal label",
      "placeholder": "The moment of truth",
      "default": "The moment of truth",
      "maxLength": 40
    },
    "proposalTitle": {
      "type": "text",
      "label": "Proposal heading",
      "placeholder": "Will You Be Mine, Forever?",
      "default": "Will You Be Mine, Forever?",
      "maxLength": 80
    },
    "proposalBody": {
      "type": "textarea",
      "label": "Proposal body",
      "placeholder": "Every day with you…",
      "default": "Every day with you feels like the first day of something wonderful. I don't want to imagine a life that doesn't have you in it. I'm asking — with all my heart — will you be mine?",
      "maxLength": 400
    },
    "certificateTitle": {
      "type": "text",
      "label": "Certificate title",
      "placeholder": "Certificate of Love",
      "default": "Certificate of Love",
      "maxLength": 60
    },
    "certificateNote": {
      "type": "textarea",
      "label": "Certificate note",
      "placeholder": "Officially certified forever…",
      "default": "This certifies that the two people named below are, from this day forward, officially, irrevocably, and forever in love. Terms: endless. Expiry: never.",
      "maxLength": 500
    },
    "proposalFooter": {
      "type": "text",
      "label": "Proposal footer",
      "placeholder": "Yours, forever ♥",
      "default": "Yours, forever ♥",
      "maxLength": 80
    },
    "proposalButton": {
      "type": "text",
      "label": "Replay button (proposal mode)",
      "placeholder": "Replay our story",
      "default": "Replay our story ↻",
      "maxLength": 40
    },

    "songEnabled": {
      "type": "select",
      "label": "Enable song?",
      "default": "yes",
      "options": [
        { "value": "yes", "label": "Yes — play background music" },
        { "value": "no", "label": "No — keep it silent" }
      ]
    },
    "songSrc": {
      "type": "text",
      "label": "Song file name",
      "placeholder": "song.mp3",
      "default": "song.mp3",
      "maxLength": 100,
      "help": "Place the file in the same folder as this template."
    }
  }
}