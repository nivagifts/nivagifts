{
  "id": "birthday-magic",
  "name": "Birthday Magic",
  "category": "birthday",
  "description": "A joyful multi-page birthday experience filled with wishes, memories, photos, a love letter, a video memory, and a fun heart-catching game.",
  "price": 499,
  "currency": "INR",
  "version": "1.1.0",
  "active": true,
  "templatePath": "/templates/birthday/birthday-magic/template.html",
  "previewImage": "/templates/birthday/birthday-magic/preview.jpg",
  "features": [
    "Animated welcome and gift box",
    "Personalised birthday greeting",
    "Love letter",
    "Photo gallery (5 memories)",
    "Interactive birthday quiz",
    "Final message card with confetti",
    "Optional background music",
    "Light / dark theme + colour palette selector",
    "Responsive on mobile and desktop"
  ],

  "templateLimits": {
    "photoSlots": 5,
    "note": "Template has exactly 5 photo slots. Editor must show only 5 image upload fields."
  },

  "customization": {
    "personName": {
      "label": "Birthday person's name",
      "type": "text",
      "default": "Birthday Star",
      "required": true,
      "maxLength": 60,
      "placeholder": "e.g. Anjali"
    },
    "senderName": {
      "label": "Your name",
      "type": "text",
      "default": "Someone Who Cares",
      "required": true,
      "maxLength": 60,
      "placeholder": "e.g. Arjun"
    },
    "birthdayDate": {
      "label": "Birthday date",
      "type": "date",
      "required": false,
      "help": "Used for the next-birthday countdown. Format: YYYY-MM-DD."
    },
    "letter": {
      "label": "Birthday letter opening",
      "type": "textarea",
      "default": "On your special day, I want you to know how much happiness you bring into the world. You deserve beautiful moments, kind people, wonderful surprises, and countless reasons to smile.",
      "required": true,
      "maxLength": 2500
    },

    "themeMode": {
      "label": "Theme mode",
      "type": "select",
      "default": "light",
      "required": false,
      "options": [
        { "value": "light", "label": "Light (soft & airy)" },
        { "value": "dark",  "label": "Dark (romantic & cosy)" }
      ],
      "help": "Switches the whole website between light and dark theme."
    },

    "colorPalette": {
      "label": "Colour palette",
      "type": "select",
      "default": "blush-pink",
      "required": false,
      "options": [
        { "value": "blush-pink",     "label": "Blush Pink (default)" },
        { "value": "rose-gold",      "label": "Rose Gold" },
        { "value": "lavender-dream", "label": "Lavender Dream" },
        { "value": "peach-cream",    "label": "Peach Cream" },
        { "value": "mint-breeze",    "label": "Mint Breeze" },
        { "value": "midnight-rose",  "label": "Midnight Rose (pairs with dark mode)" }
      ],
      "help": "Changes accent, button and background tint colours."
    },

    "photos": {
      "label": "Birthday memories (exactly 5)",
      "type": "imageGallery",
      "required": false,
      "maxFiles": 5,
      "minFiles": 0,
      "maxSizeMB": 50,
      "accept": "image/jpeg,image/png,image/webp",
      "help": "Template shows 5 photo slots. Upload up to 5 images — no more."
    },

    "captions": {
      "label": "Photo captions (5)",
      "type": "textArray",
      "default": [
        "A memory to treasure ♡",
        "A little moment of happiness ✨",
        "A smile worth remembering 🌸",
        "One for the memory book 💗",
        "More beautiful moments ahead 🎂"
      ],
      "required": false,
      "maxItems": 5,
      "help": "One caption per line. Pairs with each photo in order."
    },

    "music": {
      "label": "Background music",
      "type": "audio",
      "required": false,
      "maxSizeMB": 20,
      "accept": "audio/mpeg,audio/mp3,audio/wav,audio/ogg",
      "help": "Optional. Add a birthday song."
    }
  },

  "sections": [
    {
      "title": "The birthday person",
      "subtitle": "Who is today for?",
      "fields": ["personName", "senderName", "birthdayDate"]
    },
    {
      "title": "Your letter",
      "subtitle": "Put the feelings into words.",
      "fields": ["letter"]
    },
    {
      "title": "Theme & colours",
      "subtitle": "Match the website to your mood.",
      "fields": ["themeMode", "colorPalette"]
    },
    {
      "title": "Your memories",
      "subtitle": "Add exactly 5 photos and captions.",
      "fields": ["photos", "captions"]
    },
    {
      "title": "Music",
      "subtitle": "Optional soundtrack.",
      "fields": ["music"]
    }
  ],

  "preview": {
    "nameField": "personName",
    "senderField": "senderName",
    "messageField": "letter",
    "photosField": "photos",
    "themeField": "themeMode",
    "paletteField": "colorPalette"
  }
}