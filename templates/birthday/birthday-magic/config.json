{
  "id": "birthday-magic",
  "name": "Birthday Magic",
  "category": "birthday",
  "description": "A joyful multi-page birthday experience filled with wishes, memories, photos, a love letter, a video memory, and a fun heart-catching game.",
  "price": 499,
  "currency": "INR",
  "version": "1.0.0",
  "active": true,
  "templatePath": "/templates/birthday/birthday-magic/template.html",
  "previewImage": "/templates/birthday/birthday-magic/preview.jpg",
  "features": [
    "Animated welcome and gift box",
    "Personalised birthday greeting",
    "Love letter",
    "Two photo galleries (10 memories)",
    "Video memory page",
    "Interactive heart-catching game",
    "Final message card with confetti",
    "Optional background music",
    "Responsive on mobile and desktop"
  ],
  "customization": {
    "personName": {
      "label": "Birthday person's name",
      "type": "text",
      "default": "My Favourite Person",
      "required": true,
      "maxLength": 60,
      "placeholder": "e.g. Anjali"
    },
    "senderName": {
      "label": "Your name",
      "type": "text",
      "default": "Your Favourite Human",
      "required": true,
      "maxLength": 60,
      "placeholder": "e.g. Arjun"
    },
    "letter": {
      "label": "Birthday letter",
      "type": "textarea",
      "default": "Happy Birthday, my love.\n\nI wish I could put into words how much happiness you bring into my life. Every little moment with you becomes a memory I want to keep forever.\n\nYou deserve all the beautiful things this world has to offer. I hope this new chapter brings you countless reasons to smile.\n\nThank you for being you.",
      "required": true,
      "maxLength": 2500
    },
    "photos": {
      "label": "Birthday memories (up to 10)",
      "type": "imageGallery",
      "required": false,
      "maxFiles": 10,
      "maxSizeMB": 150,
      "accept": "image/jpeg,image/png,image/webp",
      "help": "Photos up to 50 MB each. Shown 5 per gallery page."
    },
    "captions": {
      "label": "Photo captions",
      "type": "textArray",
      "default": [
        "A favourite moment", "Your beautiful smile", "A memory to keep",
        "My happy place", "Just us", "Little things, big love",
        "Forever remembered", "My favourite human", "Another reason to smile",
        "A moment with you"
      ],
      "required": false,
      "maxItems": 10,
      "help": "One caption per line. Pairs with each photo in order."
    },
    "video": {
      "label": "Memory video",
      "type": "video",
      "required": false,
      "maxSizeMB": 150,
      "accept": "video/mp4,video/webm",
      "help": "A short video memory (MP4 or WebM). Max 100 MB."
    },
    "music": {
      "label": "Background music",
      "type": "audio",
      "required": false,
      "maxSizeMB": 20,
      "accept": "audio/mpeg,audio/mp3,audio/wav,audio/ogg",
      "help": "Optional. Add a birthday song."
    },
    "gameDuration": {
      "label": "Game duration (seconds)",
      "type": "text",
      "default": "15",
      "required": false,
      "maxLength": 2,
      "help": "How long the heart-catching game lasts. Recommended: 10–25 seconds."
    }
  },
  "sections": [
    { "title": "The birthday person", "subtitle": "Who is today for?", "fields": ["personName", "senderName"] },
    { "title": "Your letter", "subtitle": "Put the feelings into words.", "fields": ["letter"] },
    { "title": "Your memories", "subtitle": "Add photos and captions.", "fields": ["photos", "captions"] },
    { "title": "A little movie", "subtitle": "Add a short video memory.", "fields": ["video"] },
    { "title": "Music & game", "subtitle": "Soundtrack and game length.", "fields": ["music", "gameDuration"] }
  ],
  "preview": {
    "nameField": "personName",
    "senderField": "senderName",
    "messageField": "letter",
    "photosField": "photos",
    "themeField": null
  }
}