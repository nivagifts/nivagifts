{
  "id": "memory-roll",
  "name": "Memory Roll",
  "category": "memories",
  "price": 299,
  "description": "An interactive 6-page memory journey featuring a vintage camera opening, a creative Polaroid photo album, a personal timeline, favourite places, a memory quiz, and a heartfelt finale.",
  "templatePath": "/templates/memories/memory-roll/template.html",
  "thumbnail": "/templates/memories/memory-roll/thumb.jpg",
  "templateLimits": {
    "photoSlots": 11
  },
  "sections": [
    {
      "title": "The Memory Keepers",
      "subtitle": "Who is this memory gift for?",
      "fields": [
        "recipientName",
        "senderName"
      ]
    },
    {
      "title": "Theme & Colours",
      "subtitle": "Choose the scrapbook look",
      "fields": [
        "themeStyle",
        "colorCombo"
      ]
    },
    {
      "title": "Page 1 — Camera Cover",
      "subtitle": "The vintage camera opening",
      "fields": [
        "coverEyebrow",
        "coverTitle",
        "coverSubtitle",
        "coverButton"
      ]
    },
    {
      "title": "Page 2 — Photo Album",
      "subtitle": "Add up to eight favourite photographs",
      "fields": [
        "albumTitle",
        "albumSubtitle",
        "photo1",
        "photoCaption1",
        "photo2",
        "photoCaption2",
        "photo3",
        "photoCaption3",
        "photo4",
        "photoCaption4",
        "photo5",
        "photoCaption5",
        "photo6",
        "photoCaption6",
        "photo7",
        "photoCaption7",
        "photo8",
        "photoCaption8"
      ]
    },
    {
      "title": "Page 3 — Memory Timeline",
      "subtitle": "Add three important moments",
      "fields": [
        "timelineTitle",
        "timeline1Date",
        "timeline1Title",
        "timeline1Text",
        "timeline2Date",
        "timeline2Title",
        "timeline2Text",
        "timeline3Date",
        "timeline3Title",
        "timeline3Text"
      ]
    },
    {
      "title": "Page 4 — Favourite Places",
      "subtitle": "Places that hold special memories",
      "fields": [
        "placesTitle",
        "place1Name",
        "place1Note",
        "place1Image",
        "place2Name",
        "place2Note",
        "place2Image",
        "place3Name",
        "place3Note",
        "place3Image"
      ]
    },
    {
      "title": "Page 5 — Memory Game",
      "subtitle": "Create a little quiz for the recipient",
      "fields": [
        "gameTitle",
        "quizQuestion",
        "quizOption1",
        "quizOption2",
        "quizOption3",
        "quizAnswer"
      ]
    },
    {
      "title": "Page 6 — Final Message",
      "subtitle": "End the journey with a personal note",
      "fields": [
        "finalTitle",
        "finalMessage",
        "finalButton"
      ]
    }
  ],
  "customization": {
    "recipientName": {
      "type": "text",
      "label": "Recipient's name",
      "placeholder": "e.g. Riya",
      "default": "Someone Special",
      "required": true,
      "maxLength": 30
    },
    "senderName": {
      "type": "text",
      "label": "Your name",
      "placeholder": "e.g. Alex",
      "default": "Someone who cares",
      "required": true,
      "maxLength": 40
    },
    "themeStyle": {
      "type": "select",
      "label": "Album style",
      "default": "film",
      "options": [
        {
          "value": "film",
          "label": "Vintage Film — classic camera scrapbook"
        },
        {
          "value": "polaroid",
          "label": "Polaroid — playful photo memories"
        },
        {
          "value": "journal",
          "label": "Memory Journal — soft paper aesthetic"
        }
      ],
      "help": "Choose the overall memory album style."
    },
    "colorCombo": {
      "type": "select",
      "label": "Colour palette",
      "default": "warm",
      "options": [
        {
          "value": "warm",
          "label": "Warm Beige — cream, brown and caramel"
        },
        {
          "value": "rose",
          "label": "Soft Rose — blush, cream and cocoa"
        },
        {
          "value": "sage",
          "label": "Sage — muted green and ivory"
        },
        {
          "value": "blue",
          "label": "Dusty Blue — soft blue and parchment"
        }
      ],
      "help": "Choose the scrapbook accent palette."
    },
    "coverEyebrow": {
      "type": "text",
      "label": "Cover small heading",
      "default": "A collection of little forever moments",
      "maxLength": 70
    },
    "coverTitle": {
      "type": "text",
      "label": "Cover title",
      "default": "Our Memory Roll",
      "required": true,
      "maxLength": 50
    },
    "coverSubtitle": {
      "type": "textarea",
      "label": "Cover message",
      "default": "Every picture has a story. Every story has a place in my heart.",
      "maxLength": 220
    },
    "coverButton": {
      "type": "text",
      "label": "Cover button text",
      "default": "Open the camera",
      "maxLength": 40
    },
    "albumTitle": {
      "type": "text",
      "label": "Album title",
      "default": "The little things we keep",
      "maxLength": 60
    },
    "albumSubtitle": {
      "type": "text",
      "label": "Album subtitle",
      "default": "Tap any photograph to see it a little closer.",
      "maxLength": 120
    },
    "photo1": {
      "type": "image",
      "label": "Album photo 1",
